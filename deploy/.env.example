# Copy to deploy/.env. Never commit the real file.
# A free DNS subdomain can be used; its A record must point at your VM's public IP.
PUBLIC_HOST=play.example.com
PUBLIC_URL=https://play.example.com
# Include PUBLIC_URL. Add the frontend's ORIGIN, without its /DozenWar path, if using GitHub Pages.
ALLOWED_ORIGINS=https://play.example.com,https://khuely93.github.io
# Generate with: openssl rand -hex 32
POSTGRES_PASSWORD=REPLACE_WITH_A_NEW_RANDOM_PASSWORD
MAX_ROOMS=20
APP_TAG=local
